# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY — never prefix with NEXT_PUBLIC_, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the NUC uses to authenticate to /api/ingest.
# Generate a long random string, e.g.: openssl rand -hex 32
NUC_DEVICE_SECRET=change-me-to-something-random

# Shared secret an iOS Shortcut uses to authenticate to /api/quick/nurse.
# Generate a long random string, e.g.: openssl rand -hex 32
QUICK_TOGGLE_SECRET=change-me-to-something-random

# A qué bebé le escribe /api/quick/nurse.
#
# Opcional mientras haya UN SOLO bebé en la base: el endpoint lo resuelve solo.
# En cuanto haya más de uno, el endpoint FALLA CERRADO (409) hasta que esta
# variable esté seteada — antes adivinaba, y adivinaba mal (hallazgo C1 de
# docs/auditorias/2026-09-20-auditoria-inicial.md).
QUICK_TOGGLE_BABY_ID=
