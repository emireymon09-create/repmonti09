# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY — never prefix with NEXT_PUBLIC_, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Los dispositivos (NUC, Shortcut de iOS) ya no usan secretos compartidos acá:
# cada uno tiene su token en la tabla device_tokens. Crearlos con
#   pnpm device-token create --family <uuid> [--baby <uuid>] --label <texto> --scope ingest|quick_nurse|push_check

# Push (aviso de toma de pecho larga). Par VAPID, RFC 8292. Local: `pnpm db:env`
# las genera si faltan y nunca pisa las que hay — cambiar el par deja muertas
# todas las suscripciones hechas con el viejo. En producción se generan una vez
# (`node scripts/vapid-keys.mjs`) y se cargan en el panel del deploy.
# Pública — el navegador la necesita para suscribirse.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# SERVER-ONLY — firma cada envío. Jamás NEXT_PUBLIC_, jamás en un 'use client'.
VAPID_PRIVATE_KEY=
# SERVER-ONLY — contacto que ve el servicio de push. En producción, un mailto: real.
VAPID_SUBJECT=mailto:you@example.com
